# Porta do servidor
PORT=3000
# Onde fica o banco de dados (SQLite)
DB_DIR=./dados/pg
# Fuso horário usado nos e-mails
TZ_APP=America/Sao_Paulo

# (Opcional) E-mail via variáveis de ambiente — se preferir, configure pela tela "Ajustes".
# EMAIL_ATIVO=1
# EMAIL_DESTINO=voce@exemplo.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=voce@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=Jurify <voce@gmail.com>

# (Opcional) Contato usado nas notificações push (exigido pelo padrão Web Push)
# VAPID_SUBJECT=mailto:voce@exemplo.com

# (Opcional) Se o CNJ trocar a chave pública do DataJud:
# DATAJUD_API_KEY=
