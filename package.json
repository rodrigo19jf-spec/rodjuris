{
  "name": "rodjuris",
  "version": "1.0.0",
  "description": "Gestão pessoal de processos judiciais, lembretes, agenda e monitoramento de publicações (DJEN/DataJud)",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
